generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum LobbyStatus {
  WAITING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum DisputeStatus {
  IN_PROGRESS
  JUDGING
  COMPLETED
  CANCELLED
}

enum ReportStatus {
  PENDING
  REVIEWED
  DISMISSED
}

enum NotificationType {
  DISPUTE_RESULT
  REMATCH_REQUEST
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String   @unique
  passwordHash String
  elo          Int      @default(1200)
  role         String   @default("user")
  isBanned     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  lobbyPlayers      LobbyPlayer[]
  disputePlayers    DisputePlayer[]
  messages          Message[]
  notifications     Notification[]
  reportsFiled      Report[]           @relation("ReportsFiled")
  reportsReceived   Report[]           @relation("ReportsReceived")
  pushSubscriptions PushSubscription[]
}

model Lobby {
  id                    String      @id @default(cuid())
  creatorId             String
  status                LobbyStatus @default(WAITING)
  topic                 String?
  maxMessageTimeSeconds Int         @default(60)
  messageWordLimit      Int         @default(200)
  totalWordLimit        Int         @default(10000)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  players LobbyPlayer[]
  dispute Dispute?
}

model LobbyPlayer {
  id       String   @id @default(cuid())
  lobbyId  String
  userId   String
  isReady  Boolean  @default(false)
  joinedAt DateTime @default(now())

  lobby Lobby @relation(fields: [lobbyId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])

  @@unique([lobbyId, userId])
}

model Dispute {
  id        String        @id @default(cuid())
  lobbyId   String        @unique
  status    DisputeStatus @default(IN_PROGRESS)
  startedAt DateTime      @default(now())
  endedAt   DateTime?
  wordsUsed Int           @default(0)
  isPrivate Boolean       @default(false)

  lobby    Lobby           @relation(fields: [lobbyId], references: [id])
  players  DisputePlayer[]
  messages Message[]
  result   DisputeResult?
  reports  Report[]
}

model DisputePlayer {
  id             String  @id @default(cuid())
  disputeId      String
  userId         String
  circlePosition Int
  isActive       Boolean @default(true)
  eloChange      Int     @default(0)

  dispute Dispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@unique([disputeId, userId])
}

model Message {
  id         String   @id @default(cuid())
  disputeId  String
  userId     String
  content    String
  wordCount  Int
  turnNumber Int
  createdAt  DateTime @default(now())

  dispute Dispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])
}

model DisputeResult {
  id             String   @id @default(cuid())
  disputeId      String   @unique
  claudeResponse String
  winnerIds      String[]
  reason         String
  createdAt      DateTime @default(now())

  dispute Dispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  payload   Json
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Report {
  id             String       @id @default(cuid())
  reporterId     String
  reportedUserId String
  disputeId      String?
  reason         String
  status         ReportStatus @default(PENDING)
  adminNote      String?
  createdAt      DateTime     @default(now())

  reporter     User     @relation("ReportsFiled", fields: [reporterId], references: [id])
  reportedUser User     @relation("ReportsReceived", fields: [reportedUserId], references: [id])
  dispute      Dispute? @relation(fields: [disputeId], references: [id])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
